           <property name="styleSheet">
            <string notr="true">            QPushButton {
				  border: 1px solid rgb(149, 149, 149);
                background-color: rgb(222, 222, 222);
                border-radius: 10px; 
        /* Simulating shadow via independent border rules */
        border-top:0px solid rgb(139, 139, 139);
        border-left: 0px solid rgb(139, 139, 139);
        border-right: 1px solid rgb(190, 190, 190);
        border-bottom: 1px solid rgb(190, 190, 190)
            }


    QPushButton:pressed {
	background-color:  rgb(179, 179, 179); 
        /* Move the border when pressed to mimic a real click */
        border-top:1px solid rgb(139, 139, 139);
        border-left: 1px solid rgb(139, 139, 139);
        border-right: 0px solid rgb(190, 190, 190);
        border-bottom: 0px solid rgb(190, 190, 190)
    }</string>
           </property>
