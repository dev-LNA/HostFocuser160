              <property name="styleSheet">
               <string notr="true">            QSlider::groove:horizontal {
                border: 1px solid #bbb;
                height:6px;
                background: #d3d3d3; /* Color AFTER the handle */
                border-radius: 4px;
            }

            QSlider::sub-page:horizontal {
                background: qlineargradient(spread:reflect, x1:0.499, y1:0, x2:0.489161, y2:0.499, stop:0 rgba(20, 56, 110, 255), stop:0.693122 rgba(20, 56, 110, 160)); /* Color BEFORE the handle */
                border: 1px solid #bbb;
                height: 8px;
                border-radius: 4px;
            }

            QSlider::handle:horizontal {
                background: #ffffff;
                border: 1px solid #555555;
                width: 10px;
                margin-top: -4px; /* Centers the handle over the groove */
                margin-bottom: -4px;
                border-radius: 2px;
            }

            QSlider::handle:horizontal:hover {
                background: #e6e6e6;
                border-color: #8242b8;
            }</string>
