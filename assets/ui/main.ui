  <property name="styleSheet">
   <string notr="true">*[statusLed=&quot;OK&quot;] {
margin:0px;
border-radius: 10px;
/*border:1px solid  rgba(170, 170, 170, 50);*/
background-color: qradialgradient(spread:reflect, cx:0.5, cy:0.5, radius:0.486, fx:0.602, fy:0.630682, stop:0 rgba(68, 255, 0, 239), stop:1 rgba(0, 157, 0, 239))
 }

*[statusLed=&quot;NOK&quot;] {
margin:0px;
 border-radius: 10px;
/*border:1px solid rgba(0, 0, 0, 50);*/
padding: 0px;
background-color: qradialgradient(spread:reflect, cx:0.5, cy:0.5, radius:0.486, fx:0.602, fy:0.63, stop:0 rgba(255, 76, 76, 239), stop:1 rgba(157, 0, 0, 239))
 }

 *[statusLed=&quot;OFF&quot;] {
margin:0px;
 border-radius: 10px;
/*border:1px solid rgba(0, 0, 0, 50);*/
padding: 0px;
/*background-color: qradialgradient(spread:reflect, cx:0.5, cy:0.5, radius:0.486, fx:0.602, fy:0.630682, stop:0 rgba(255, 255, 255, 239), stop:1 rgba(157, 157, 157, 239))*/
background-color: qradialgradient(spread:reflect, cx:0.5, cy:0.5, radius:0.486, fx:0.602, fy:0.602, stop:0 rgba(255, 255, 255, 239), stop:1 rgba(100, 100, 100, 239))
 } 

 *[statusLed=&quot;WAIT&quot;] {
margin:0px;
 border-radius: 10px;
/*border:1px solid rgba(0, 0, 0, 50);*/
padding: 0px;
background-color: qradialgradient(spread:reflect, cx:0.5, cy:0.5, radius:0.486, fx:0.602, fy:0.63, stop:0 rgba(255, 255, 126, 239), stop:1 rgba(184, 184, 0, 228))
 } 

 QProgressBar[conStatusBar] { 
    border-radius: 0px;
	background-color: rgba(0,0,0,0);
}
QProgressBar[conStatusBar=&quot;waiting&quot;]::chunk {
    background-color: qlineargradient(spread:reflect, x1:0.5, y1:0.5, x2:0.5, y2:1, stop:0.768362 rgba(255, 0, 0, 255), stop:1 rgba(255, 0, 0, 177));
}
QProgressBar[conStatusBar=&quot;connecting&quot;]::chunk {
    background-color: qlineargradient(spread:reflect, x1:0.5, y1:0.5, x2:0.5, y2:1, stop:0 rgba(255, 200, 0, 255), stop:1 rgba(188, 147, 0, 168));
}
QProgressBar[conStatusBar=&quot;connected&quot;]::chunk {
    background-color: qlineargradient(spread:reflect, x1:0.5, y1:0.5, x2:0.5, y2:1, stop:0 rgba(85, 255, 0, 255), stop:1 rgba(0, 157, 0, 168));
}


</string>
